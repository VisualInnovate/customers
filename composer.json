{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "dacoto/laravel-env-set": "^1.0",
        "giggsey/libphonenumber-for-php": "^8.13",
        "google/recaptcha": "^1.3",
        "guzzlehttp/guzzle": "^7.8",
        "inertiajs/inertia-laravel": "^0.6.10",
        "laravel/framework": "^10.10",
        "laravel/pulse": "^1.4",
        "laravel/sanctum": "^3.2",
        "laravel/socialite": "^5.12",
        "laravel/tinker": "^2.8",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "mews/purifier": "^3.4",
        "nesbot/carbon": "^2.72",
        "netflie/whatsapp-cloud-api": "^2.1",
        "nwidart/laravel-modules": "^10.0",
        "opcodesio/log-viewer": "^3.12",
        "openai-php/client": "^0.10.1",
        "phpoffice/phpword": "^1.2",
        "propaganistas/laravel-phone": "^5.0",
        "pusher/pusher-php-server": "^7.2",
        "resend/resend-laravel": "^0.11.0",
        "sentry/sentry-laravel": "^4.10",
        "smalot/pdfparser": "^2.10",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-slack-alerts": "^1.5",
        "stripe/stripe-php": "^13.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "modules/",
            "OrganizationModules\\": "OrganizationModules/"
        },
        "files": [
            "app/Helpers/DateTimeHelper.php",
            "app/Helpers/CustomHelper.php"
        ],
        "exclude-from-classmap": [
            "app/Hesabe/Controllers/PaymentController.php",
            "app/Hesabe/Models/HesabeCheckoutRequestModel.php",
            "app/Hesabe/Models/HesabePaymentResponseModel.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "OrganizationModules/*/composer.json"
            ]
    }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
